# AI configuration (optional).
# Without keys, the app runs in mock mode: predefined texts + device TTS.
# Copy this file to ".env" and fill in your keys.
# Note: EXPO_PUBLIC_* gets inlined into the client bundle — for a release,
# put a backend proxy in front (see src/lib/ai/config.ts).

# Anthropic (text generation)
EXPO_PUBLIC_ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-opus-4-8)
# EXPO_PUBLIC_ANTHROPIC_MODEL=claude-opus-4-8

# Fish Audio (cloud TTS, optional — otherwise device TTS)
EXPO_PUBLIC_FISHAUDIO_API_KEY=
# Optional: override the model (default: s2.1-pro-free)
# EXPO_PUBLIC_FISHAUDIO_MODEL=s2.1-pro-free
# Optional: your own reference_ids per voice (otherwise Fish Audio's default voice)
# EXPO_PUBLIC_FISHAUDIO_VOICE_WARM=
# EXPO_PUBLIC_FISHAUDIO_VOICE_CLEAR=
# EXPO_PUBLIC_FISHAUDIO_VOICE_DEEP=
